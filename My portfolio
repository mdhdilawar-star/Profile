    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css">
    <style>
        :root {
            --bg-deep: #030308;
            --bg-primary: #070810;
            --bg-secondary: #0a0d18;
            --bg-card: #0e1122;
            --glass-bg: rgba(12, 15, 28, 0.78);
            --glass-border: rgba(255, 255, 255, 0.08);
            --glass-border-hover: rgba(240, 200, 80, 0.45);
            --royal-blue: #1a56db;
            --cyan: #06b6d4;
            --emerald: #10b981;
            --purple: #8b5cf6;
            --neon-cyan: #00e5ff;
            --neon-purple: #b388ff;
            --gold: #d4af37;
            --gold-bright: #f0c850;
            --orange: #f59e0b;
            --text-primary: #f1f5f9;
            --text-secondary: #b0b3c0;
            --text-muted: #7a7d8c;
            --white: #ffffff;
            --shadow-glow-gold: 0 0 60px rgba(212, 175, 55, 0.45);
            --profile-size-hero: 265px;
            --profile-size-about: 205px;
            --profile-size-contact: 155px;
            --profile-size-floating: 64px;
            --profile-radius: 50%;
            --profile-glow-color-1: rgba(212, 175, 55, 0.75);
            --profile-glow-color-2: rgba(6, 182, 212, 0.55);
            --profile-golden-border: rgba(240, 200, 80, 0.85);
            --profile-border-width: 4px;
            --profile-shadow-depth: 0 35px 90px rgba(0, 0, 0, 0.85);
            --profile-animation-speed: 8s;
            --profile-breathing-speed: 5s;
            --profile-hover-scale: 1.08;
            --radius-sm: 14px;
            --radius-md: 20px;
            --radius-lg: 28px;
            --transition-fast: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            --transition-smooth: 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            --transition-bounce: 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
            --font-display: 'Space Grotesk', 'Outfit', sans-serif;
            --font-body: 'Inter', 'Plus Jakarta Sans', sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
            --z-loader: 10000;
            --z-nav: 1000;
            --z-floating-card: 900;
        }
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        html {
            scroll-behavior: smooth;
            scrollbar-width: thin;
            scrollbar-color: rgba(212, 175, 55, 0.6) transparent;
            font-size: 16px;
        }
        ::-webkit-scrollbar {
            width: 7px;
        }
        ::-webkit-scrollbar-track {
            background: #030308;
        }
        ::-webkit-scrollbar-thumb {
            background: linear-gradient(180deg, var(--gold), var(--cyan), var(--gold));
            border-radius: 10px;
        }
        body {
            font-family: var(--font-body);
            background: var(--bg-deep);
            color: var(--text-primary);
            line-height: 1.7;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
            position: relative;
        }

        /* ========== AMBIENT LUXURY AURORA ========== */
        .aurora-bg {
            position: fixed;
            inset: 0;
            z-index: 0;
            pointer-events: none;
            overflow: hidden;
        }
        .aurora-orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(130px);
            opacity: 0.22;
            animation: orbFloat 18s ease-in-out infinite alternate;
        }
        .aurora-orb.orb-1 {
            width: 520px;
            height: 520px;
            background: radial-gradient(circle, var(--gold-bright), transparent 70%);
            top: -120px;
            left: -120px;
        }
        .aurora-orb.orb-2 {
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, var(--cyan), transparent 70%);
            bottom: -150px;
            right: -120px;
            animation-delay: -6s;
        }
        .aurora-orb.orb-3 {
            width: 450px;
            height: 450px;
            background: radial-gradient(circle, var(--purple), transparent 70%);
            top: 40%;
            left: 55%;
            animation-delay: -11s;
        }
        @keyframes orbFloat {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(60px, -50px) scale(1.18); }
        }

        /* ========== LOADER ========== */
        #loader {
            position: fixed;
            inset: 0;
            z-index: var(--z-loader);
            background: radial-gradient(ellipse at center, #0a0b18 0%, #030308 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            transition: opacity 0.8s ease, visibility 0.8s ease;
        }
        #loader.hidden {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }
        .loader-core {
            width: 42px;
            height: 42px;
            background: radial-gradient(circle, #ffffff, var(--gold-bright));
            border-radius: 50%;
            box-shadow: 0 0 70px var(--gold-bright), 0 0 140px rgba(212, 175, 55, 0.8);
            animation: corePulse 1.5s ease-in-out infinite;
            margin-bottom: 30px;
        }
        @keyframes corePulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.35); }
        }
        .loader-text {
            font-family: var(--font-display);
            font-size: 1.45rem;
            font-weight: 800;
            letter-spacing: 0.25em;
            background: linear-gradient(135deg, var(--gold-bright), var(--cyan), var(--purple), var(--emerald));
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* ========== 3D BACKGROUND ========== */
        #three-bg {
            position: fixed;
            inset: 0;
            z-index: 0;
            pointer-events: none;
        }

        /* ========== LIGHTNING & GLASS SHARDS ========== */
        .lightning-flash {
            position: fixed;
            inset: 0;
            z-index: 9998;
            pointer-events: none;
            animation: lightningBurst 0.4s ease-out forwards;
        }
        @keyframes lightningBurst {
            0% { background: rgba(255, 255, 255, 0.65); }
            20% { background: rgba(240, 200, 80, 0.25); }
            100% { background: rgba(255, 255, 255, 0); }
        }
        .lightning-bolt {
            position: fixed;
            z-index: 9999;
            pointer-events: none;
            height: 180px;
            width: 3px;
            background: linear-gradient(to bottom, #ffffff, #f0c850, #00e5ff);
            border-radius: 2px;
            filter: blur(0.5px);
            box-shadow: 0 0 20px #fff, 0 0 60px #f0c850, 0 0 100px #d4af37;
            animation: boltStrike 0.45s ease-out forwards;
            transform-origin: top center;
        }
        @keyframes boltStrike {
            0% { opacity: 1; transform: scaleY(0); }
            20% { opacity: 1; transform: scaleY(1.2); }
            100% { opacity: 0; transform: scaleY(1); }
        }
        .glass-shards-container {
            position: fixed;
            pointer-events: none;
            z-index: 10000;
        }
        .shard-piece {
            position: absolute;
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.85), rgba(240, 200, 80, 0.7));
            clip-path: polygon(50% 0%, 100% 38%, 82% 100%, 18% 100%, 0% 38%);
            animation: shardExplode 0.75s ease-out forwards;
        }
        @keyframes shardExplode {
            0% { transform: translate(0, 0) rotate(0deg) scale(1); opacity: 1; }
            100% { transform: translate(var(--sx), var(--sy)) rotate(var(--sr)) scale(0.15); opacity: 0; }
        }

        /* ========== NAVIGATION ========== */
        .nav {
            position: fixed;
            top: 18px;
            left: 50%;
            transform: translateX(-50%);
            z-index: var(--z-nav);
            background: rgba(8, 10, 20, 0.85);
            backdrop-filter: blur(40px);
            -webkit-backdrop-filter: blur(40px);
            border: 1px solid rgba(240, 200, 80, 0.22);
            border-radius: 60px;
            padding: 8px 12px;
            display: flex;
            align-items: center;
            gap: 4px;
            box-shadow: 0 15px 55px rgba(0, 0, 0, 0.75), 0 0 30px rgba(212, 175, 55, 0.12);
        }
        .nav a {
            color: var(--text-secondary);
            text-decoration: none;
            font-family: var(--font-display);
            font-weight: 600;
            font-size: 0.82rem;
            padding: 9px 16px;
            border-radius: 30px;
            transition: all var(--transition-fast);
            white-space: nowrap;
        }
        .nav a:hover,
        .nav a.active {
            color: #05050a;
            background: linear-gradient(135deg, var(--gold-bright), var(--gold));
            box-shadow: 0 0 20px rgba(240, 200, 80, 0.5);
        }

        /* ========== PHOTO UPLOADER TRIGGER ========== */
        .photo-customizer-btn {
            position: fixed;
            top: 22px;
            right: 24px;
            z-index: var(--z-nav);
            background: rgba(12, 15, 28, 0.88);
            backdrop-filter: blur(25px);
            border: 1px solid rgba(240, 200, 80, 0.45);
            color: var(--gold-bright);
            padding: 10px 18px;
            border-radius: 40px;
            font-family: var(--font-display);
            font-size: 0.78rem;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
            transition: all var(--transition-smooth);
        }
        .photo-customizer-btn:hover {
            background: linear-gradient(135deg, var(--gold-bright), var(--gold));
            color: #05050a;
            box-shadow: 0 0 30px rgba(240, 200, 80, 0.6);
            transform: translateY(-2px);
        }

        /* ========== SECTIONS ========== */
        .section {
            position: relative;
            z-index: 2;
            padding: 110px 24px;
            max-width: 1240px;
            margin: 0 auto;
        }
        .section-label {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            letter-spacing: 0.25em;
            text-transform: uppercase;
            color: var(--gold-bright);
            margin-bottom: 14px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 18px;
            border-radius: 28px;
            background: rgba(212, 175, 55, 0.12);
            border: 1px solid rgba(212, 175, 55, 0.3);
        }
        .section-title {
            font-family: var(--font-display);
            font-size: clamp(2.2rem, 4.8vw, 3.3rem);
            font-weight: 800;
            color: var(--white);
            margin-bottom: 24px;
            letter-spacing: -0.02em;
        }
        .section-title .title-accent {
            background: linear-gradient(135deg, var(--gold-bright), var(--cyan), var(--purple), var(--emerald));
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            background-size: 300% 300%;
            animation: gradientShift 5s ease infinite;
        }
        @keyframes gradientShift {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }

        /* ========== LUXURY PROFILE IMAGE FRAMES ========== */
        .profile-img-wrapper {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            cursor: pointer;
            transition: transform var(--transition-bounce);
            filter: drop-shadow(0 0 35px rgba(212, 175, 55, 0.45));
        }
        .profile-img-wrapper:hover {
            transform: scale(var(--profile-hover-scale));
            filter: drop-shadow(0 0 55px rgba(240, 200, 80, 0.75));
        }
        .profile-img-ring {
            position: absolute;
            border-radius: 50%;
            border: 2.5px solid transparent;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            pointer-events: none;
            animation: ringRotate var(--profile-animation-speed) linear infinite;
        }
        .profile-img-ring.ring-1 {
            width: calc(100% + 28px);
            height: calc(100% + 28px);
            border-top-color: var(--gold-bright);
            border-left-color: rgba(6, 182, 212, 0.6);
            animation-duration: 9s;
        }
        .profile-img-ring.ring-2 {
            width: calc(100% + 48px);
            height: calc(100% + 48px);
            border-bottom-color: var(--gold);
            border-right-color: rgba(139, 92, 246, 0.6);
            animation-duration: 13s;
            animation-direction: reverse;
        }
        @keyframes ringRotate {
            from { transform: translate(-50%, -50%) rotate(0deg); }
            to { transform: translate(-50%, -50%) rotate(360deg); }
        }
        .profile-img-glow {
            position: absolute;
            width: calc(100% + 90px);
            height: calc(100% + 90px);
            border-radius: 50%;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: -1;
            background: radial-gradient(circle, var(--profile-glow-color-1) 0%, var(--profile-glow-color-2) 45%, transparent 72%);
            animation: glowBreathe var(--profile-breathing-speed) ease-in-out infinite;
            filter: blur(32px);
        }
        @keyframes glowBreathe {
            0%, 100% { opacity: 0.65; transform: translate(-50%, -50%) scale(0.98); }
            50% { opacity: 1; transform: translate(-50%, -50%) scale(1.18); }
        }
        .profile-img {
            display: block;
            border-radius: var(--profile-radius);
            object-fit: cover;
            object-position: center 18%;
            aspect-ratio: 1/1;
            border: var(--profile-border-width) solid var(--profile-golden-border);
            box-shadow: var(--profile-shadow-depth), 0 0 45px rgba(212, 175, 55, 0.55);
            z-index: 2;
            animation: profileFloat 6s ease-in-out infinite;
            background: linear-gradient(135deg, #121629, #090b14);
        }
        @keyframes profileFloat {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-14px); }
        }
        .profile-img.hero-size { width: var(--profile-size-hero); height: var(--profile-size-hero); }
        .profile-img.about-size { width: var(--profile-size-about); height: var(--profile-size-about); }
        .profile-img.contact-size { width: var(--profile-size-contact); height: var(--profile-size-contact); }
        .profile-img.floating-size { width: var(--profile-size-floating); height: var(--profile-size-floating); animation: none; border-width: 2.5px; }

        .status-badge {
            position: absolute;
            bottom: 12px;
            right: 12px;
            z-index: 4;
            background: rgba(6, 12, 24, 0.92);
            border: 1.5px solid var(--emerald);
            color: var(--white);
            padding: 5px 12px;
            border-radius: 30px;
            font-family: var(--font-mono);
            font-size: 0.7rem;
            display: flex;
            align-items: center;
            gap: 6px;
            box-shadow: 0 5px 20px rgba(16, 185, 129, 0.4);
        }
        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--emerald);
            box-shadow: 0 0 10px var(--emerald);
            animation: pulseDot 1.5s infinite;
        }
        @keyframes pulseDot {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.4); opacity: 0.6; }
        }

        /* ========== HERO ========== */
        .hero-section {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 140px 24px 90px;
        }
        .hero-container {
            max-width: 1020px;
            width: 100%;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 20px;
        }
        .luxury-pill {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 8px 22px;
            border-radius: 50px;
            background: rgba(240, 200, 80, 0.1);
            border: 1px solid rgba(240, 200, 80, 0.35);
            color: var(--gold-bright);
            font-family: var(--font-mono);
            font-size: 0.8rem;
            letter-spacing: 0.08em;
            margin-top: 8px;
        }
        .hero-name {
            font-family: var(--font-display);
            font-size: clamp(2.8rem, 7vw, 5.2rem);
            font-weight: 800;
            color: var(--white);
            line-height: 1.1;
        }
        .hero-name .highlight {
            background: linear-gradient(135deg, var(--gold-bright), var(--cyan), var(--purple), var(--emerald));
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: gradientShift 5s ease infinite;
            background-size: 300% 300%;
        }
        .hero-title {
            font-family: var(--font-display);
            font-size: clamp(1.05rem, 2.2vw, 1.42rem);
            font-weight: 600;
            color: var(--text-primary);
            max-width: 850px;
        }
        .hero-typing {
            font-family: var(--font-mono);
            font-size: 1.05rem;
            color: var(--gold-bright);
            min-height: 32px;
            background: rgba(255, 255, 255, 0.03);
            padding: 6px 20px;
            border-radius: 30px;
            border: 1px solid rgba(255, 255, 255, 0.06);
        }
        .hero-summary {
            color: var(--text-secondary);
            font-size: 1.04rem;
            max-width: 820px;
            line-height: 1.85;
        }
        .hero-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
            justify-content: center;
            margin-top: 10px;
        }

        /* ========== BUTTONS ========== */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 14px 28px;
            border-radius: 55px;
            font-family: var(--font-display);
            font-weight: 600;
            font-size: 0.9rem;
            text-decoration: none;
            cursor: pointer;
            border: 1px solid var(--glass-border);
            transition: all var(--transition-bounce);
            background: var(--glass-bg);
            backdrop-filter: blur(25px);
            color: var(--white);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
        }
        .btn:hover {
            border-color: var(--gold-bright);
            transform: translateY(-5px);
            box-shadow: var(--shadow-glow-gold), 0 18px 50px rgba(0, 0, 0, 0.65);
        }
        .btn-primary {
            background: linear-gradient(135deg, #b8860b, var(--gold-bright), #d97706);
            color: #05050a;
            font-weight: 700;
            border-color: transparent;
        }
        .btn-primary:hover {
            color: #000;
            box-shadow: 0 0 45px rgba(240, 200, 80, 0.8);
        }
        .btn-whatsapp {
            background: linear-gradient(135deg, #059669, #10b981);
            border-color: transparent;
            color: var(--white);
        }

        /* ========== GLASS CARD & CLAY ICON ========== */
        .glass-card {
            background: var(--glass-bg);
            backdrop-filter: blur(35px);
            -webkit-backdrop-filter: blur(35px);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-lg);
            padding: 32px;
            transition: all var(--transition-smooth);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45);
            position: relative;
            overflow: hidden;
        }
        .glass-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--gold-bright), var(--cyan), transparent);
            transition: left 0.8s ease;
        }
        .glass-card:hover::before {
            left: 100%;
        }
        .glass-card:hover {
            border-color: var(--glass-border-hover);
            box-shadow: 0 25px 70px rgba(0, 0, 0, 0.75), 0 0 40px rgba(212, 175, 55, 0.22);
            transform: translateY(-7px);
        }
        .clay-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 20px;
            background: linear-gradient(145deg, #1e2235, #101320);
            box-shadow: 6px 6px 14px #06080e, -6px -6px 14px #1e2436, inset 1px 1px 3px rgba(240, 200, 80, 0.2);
            transition: all var(--transition-smooth);
            flex-shrink: 0;
        }
        .clay-icon i {
            background: linear-gradient(135deg, var(--gold-bright), var(--cyan), var(--purple));
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* ========== STATS ========== */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
            gap: 22px;
            margin: 45px 0 10px;
        }
        .stat-card {
            text-align: center;
            padding: 32px 22px;
            border-radius: var(--radius-lg);
            background: rgba(14, 18, 32, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.07);
            transition: all var(--transition-smooth);
        }
        .stat-card:hover {
            border-color: var(--gold-bright);
            box-shadow: 0 0 45px rgba(212, 175, 55, 0.28);
            transform: translateY(-8px);
        }
        .stat-number {
            font-family: var(--font-display);
            font-size: 3.1rem;
            font-weight: 800;
            background: linear-gradient(135deg, var(--gold-bright), var(--cyan), var(--purple));
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* ========== LIVE PROJECTS SHOWCASE ========== */
        .projects-grid {
            display: grid;
