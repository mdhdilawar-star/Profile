                </div>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="footer">
        <div class="social-links">
            <a href="https://github.com/mdhdilawar-star" target="_blank" title="GitHub"><i class="fab fa-github"></i></a>
            <a href="https://wa.me/923309233029" target="_blank" title="WhatsApp"><i class="fab fa-whatsapp"></i></a>
            <a href="https://linkedin.com/in/muhammad-dilawar" target="_blank" title="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
            <a href="mailto:mdhdilawar@gmail.com" title="Email"><i class="fas fa-envelope"></i></a>
            <a href="https://adveie.com" target="_blank" title="Adveie"><i class="fas fa-globe"></i></a>
            <a href="https://pakistanmart.adveie.com" target="_blank" title="PakistanMart"><i class="fas fa-shopping-bag"></i></a>
        </div>
        <p style="color:var(--text-muted);font-size:0.86rem;">
            &copy; <span id="current-year"></span> <strong style="color:var(--gold-bright);">Muhammad Dilawar</strong> — Full-Stack PHP Developer & Software Engineer. All rights reserved.
        </p>
    </footer>

    <button class="back-to-top" id="backToTop"><i class="fas fa-arrow-up"></i></button>

    <!-- SCRIPTS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/typed.js/2.1.0/typed.umd.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/vanilla-tilt/1.8.1/vanilla-tilt.min.js"></script>

    <script>
        // PROPOSAL TAB SWITCHER & ONE-CLICK COPY
        function switchProposalTab(version, btn) {
            document.querySelectorAll('.proposal-panel').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.getElementById('proposal-' + version).classList.add('active');
            btn.classList.add('active');
        }

        function copyProposalText(elementId, btn) {
            const text = document.getElementById(elementId).innerText;
            navigator.clipboard.writeText(text).then(() => {
                const orig = btn.innerHTML;
                btn.innerHTML = '<i class="fas fa-check"></i> Copied to Clipboard!';
                setTimeout(() => { btn.innerHTML = orig; }, 2200);
            });
        }

        (function() {
            // LOADER
            const loader = document.getElementById('loader');
            window.addEventListener('load', () => {
                setTimeout(() => {
                    loader.classList.add('hidden');
                    document.body.style.overflow = '';
                }, 1400);
            });

            // PROFILE PHOTO SMART LOADER & PERSISTENT BROWSER SAVER
            const profileImages = document.querySelectorAll('.user-profile-photo');
            const savedPhoto = localStorage.getItem('dilawar_luxury_profile_img');

            profileImages.forEach(img => {
                if (savedPhoto) {
                    img.src = savedPhoto;
                }
                img.addEventListener('error', function() {
                    const fallback = this.getAttribute('data-fallback');
                    if (fallback && this.src !== fallback) {
                        this.src = fallback;
                    }
                });
            });

            document.getElementById('profileUploadInput').addEventListener('change', function(e) {
                const file = e.target.files[0];
                if (!file) return;
                const reader = new FileReader();
                reader.onload = function(ev) {
                    const dataUrl = ev.target.result;
                    try {
                        localStorage.setItem('dilawar_luxury_profile_img', dataUrl);
                    } catch (err) {}
                    profileImages.forEach(img => { img.src = dataUrl; });
                };
                reader.readAsDataURL(file);
            });

            // THREE.JS LUXURY 3D PARTICLE GALAXY
            const canvas = document.getElementById('three-bg');
            const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            renderer.setSize(window.innerWidth, window.innerHeight);
            const scene = new THREE.Scene();
            const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 100);
            camera.position.z = 30;

            const particlesGeo = new THREE.BufferGeometry();
            const particleCount = 950;
            const positions = new Float32Array(particleCount * 3);
            const colors = new Float32Array(particleCount * 3);

            for (let i = 0; i < particleCount; i++) {
                positions[i * 3] = (Math.random() - 0.5) * 60;
                positions[i * 3 + 1] = (Math.random() - 0.5) * 44;
                positions[i * 3 + 2] = (Math.random() - 0.5) * 34;
                const c = Math.random();
                if (c < 0.35) {
                    colors[i * 3] = 0.94; colors[i * 3 + 1] = 0.78; colors[i * 3 + 2] = 0.31; // Gold
                } else if (c < 0.65) {
                    colors[i * 3] = 0.02; colors[i * 3 + 1] = 0.71; colors[i * 3 + 2] = 0.83; // Cyan
                } else if (c < 0.85) {
                    colors[i * 3] = 0.55; colors[i * 3 + 1] = 0.36; colors[i * 3 + 2] = 0.96; // Purple
                } else {
                    colors[i * 3] = 0.06; colors[i * 3 + 1] = 0.73; colors[i * 3 + 2] = 0.51; // Emerald
                }
            }
            particlesGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
            particlesGeo.setAttribute('color', new THREE.BufferAttribute(colors, 3));
            const particles = new THREE.Points(
                particlesGeo,
                new THREE.PointsMaterial({
                    size: 0.065,
                    vertexColors: true,
                    blending: THREE.AdditiveBlending,
                    depthWrite: false,
                    transparent: true,
                    opacity: 0.88
                })
            );
            scene.add(particles);

            let mouseX = 0, mouseY = 0;
            document.addEventListener('mousemove', (e) => {
                mouseX = (e.clientX / window.innerWidth) * 2 - 1;
                mouseY = -(e.clientY / window.innerHeight) * 2 + 1;
            });

            function animate3D() {
                requestAnimationFrame(animate3D);
                particles.rotation.y += 0.00035;
                particles.position.x += (mouseX * 2.2 - particles.position.x) * 0.02;
                particles.position.y += (mouseY * 2.2 - particles.position.y) * 0.02;
                renderer.render(scene, camera);
            }
            animate3D();

            window.addEventListener('resize', () => {
                renderer.setSize(window.innerWidth, window.innerHeight);
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
            });

            // LIGHTNING STORM & SHARD EFFECT ON CLICK
            document.addEventListener('click', function(e) {
                const flash = document.createElement('div');
                flash.className = 'lightning-flash';
                document.body.appendChild(flash);
                setTimeout(() => flash.remove(), 400);

                const bolt = document.createElement('div');
                bolt.className = 'lightning-bolt';
                bolt.style.left = (e.clientX - 1.5) + 'px';
                bolt.style.top = Math.max(0, e.clientY - 90) + 'px';
                bolt.style.height = (90 + Math.random() * 120) + 'px';
                bolt.style.transform = `rotate(${(Math.random() - 0.5) * 28}deg)`;
                document.body.appendChild(bolt);
                setTimeout(() => bolt.remove(), 450);
            });

            document.querySelectorAll('.btn').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    const container = document.createElement('div');
                    container.className = 'glass-shards-container';
                    container.style.left = e.clientX + 'px';
                    container.style.top = e.clientY + 'px';
                    document.body.appendChild(container);
                    for (let i = 0; i < 18; i++) {
                        const shard = document.createElement('div');
                        shard.className = 'shard-piece';
                        const angle = Math.random() * Math.PI * 2;
                        const distance = 35 + Math.random() * 75;
                        shard.style.setProperty('--sx', Math.cos(angle) * distance + 'px');
                        shard.style.setProperty('--sy', Math.sin(angle) * distance + 'px');
                        shard.style.setProperty('--sr', (Math.random() * 720 - 360) + 'deg');
                        shard.style.width = (5 + Math.random() * 10) + 'px';
                        shard.style.height = (5 + Math.random() * 10) + 'px';
                        container.appendChild(shard);
                    }
                    setTimeout(() => container.remove(), 800);
                });
            });

            // AOS & TYPED.JS INITIALIZATION
            AOS.init({ duration: 900, easing: 'ease-out-cubic', once: true, offset: 90 });

            new Typed('#typing-text', {
                strings: [
                    'Custom Full-Stack .PHP Architecture & MySQL Design',
                    'Creator of Adveie.com, PakistanMart & Online Free Tools',
                    'Custom LMS, E-Commerce & Fleet Booking Systems',
                    'Vanilla JavaScript (ES6+), Glassmorphism UI & SEO Ready',
                    'Python Automation, Browser Extensions & Google Apps Script',
                    '10+ Years Experience in Enterprise Excel & Data Systems'
                ],
                typeSpeed: 42,
                backSpeed: 22,
                backDelay: 2200,
                startDelay: 500,
                loop: true,
                showCursor: true,
                cursorChar: '▌'
            });

            // SKILL BARS & COUNTERS
            document.querySelectorAll('.skill-fill').forEach(f => { f.style.width = '0%'; });
            const skillObs = new IntersectionObserver((entries) => {
                entries.forEach(e => {
                    if (e.isIntersecting) {
                        e.target.style.width = e.target.getAttribute('data-width') + '%';
                        skillObs.unobserve(e.target);
                    }
                });
            }, { threshold: 0.25 });
            document.querySelectorAll('.skill-fill').forEach(f => skillObs.observe(f));

            document.querySelectorAll('.stat-number[data-count]').forEach(el => {
                const obs = new IntersectionObserver((entries) => {
                    entries.forEach(e => {
                        if (e.isIntersecting) {
                            const target = parseInt(el.getAttribute('data-count'));
                            const duration = 2000;
                            const start = performance.now();
                            function upd(ts) {
                                const p = Math.min((ts - start) / duration, 1);
                                const eased = 1 - Math.pow(1 - p, 4);
                                el.textContent = Math.round(target * eased);
                                if (p < 1) requestAnimationFrame(upd);
                                else el.textContent = target;
                            }
                            requestAnimationFrame(upd);
                            obs.unobserve(el);
                        }
                    });
                }, { threshold: 0.35 });
                obs.observe(el);
            });

            // NAVIGATION SCROLL SPY
            const navbar = document.getElementById('navbar');
            const navLinks = navbar.querySelectorAll('a');
            const sections = [];
            navLinks.forEach(l => {
                const s = document.getElementById(l.getAttribute('data-section'));
                if (s) sections.push({ id: l.getAttribute('data-section'), section: s, link: l });
            });

            function updateNav() {
                const sy = window.scrollY + 180;
                let aid = 'home';
                sections.forEach(({ id, section }) => { if (section.offsetTop <= sy) aid = id; });
                navLinks.forEach(l => l.classList.toggle('active', l.getAttribute('data-section') === aid));
            }
            window.addEventListener('scroll', updateNav);

            // BACK TO TOP
            const btt = document.getElementById('backToTop');
            window.addEventListener('scroll', () => btt.classList.toggle('visible', window.scrollY > 700));
            btt.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

            document.getElementById('current-year').textContent = new Date().getFullYear();

            // 3D TILT EFFECT ON LUXURY ELEMENTS
            if (typeof VanillaTilt !== 'undefined') {
                VanillaTilt.init(document.querySelectorAll('.profile-img-wrapper, .project-card'), {
                    max: 8,
                    speed: 400,
                    glare: true,
                    'max-glare': 0.25
                });
            }
        })();
    </script>
</body>
</html>
